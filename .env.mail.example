# Kopieer naar .env.mail; dit bestand wordt door Git genegeerd.
# Vul een NIEUWE Resend-sleutel in. Gebruik geen gedeelde of ingetrokken sleutel.
RESEND_API_KEY=
# Maak een afzonderlijke toegangscode van minimaal 32 tekens; geen Resend-sleutel.
APP_TOKEN=
ALERT_FROM=noreply@barbr.pw
ALERT_TO=ontvanger@example.com
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAIL_PORT=8787
MAIL_HOST=127.0.0.1
MAIL_DAILY_LIMIT=100
MAIL_DATA_FILE=server/.data/mail-ledger.json
